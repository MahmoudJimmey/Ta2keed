# Everything is OPTIONAL. With an empty .env the agent runs fully offline (rules-based NLU,
# demo receipts, mock courier) so judges can run it in under 5 minutes with zero accounts.

# ---- LLM (improves free-form understanding, answers questions, reads real receipt screenshots)
# LLM_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible endpoint) | offline
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL=                   # e.g. https://generativelanguage.googleapis.com/v1beta/openai  (Gemini)
#                                 #      https://api.groq.com/openai/v1                           (Groq)

# ---- Voice notes (any OpenAI-compatible Whisper endpoint; Groq is free & fast)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3

# ---- Telegram (customer channel + owner alerts/digest) — create a bot with @BotFather
# TELEGRAM_BOT_TOKEN=
# OWNER_TELEGRAM_CHAT_ID=

# ---- WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API setup) — see docs/whatsapp-setup.md
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ta2keed-verify
# WHATSAPP_APP_SECRET=            # verifies webhook signatures (recommended)
# OWNER_WHATSAPP=2010XXXXXXXX     # owner gets alerts + daily summary here; can send ملخص / شحنات / عربون

# ---- Courier (empty = mock courier; dashboard buttons simulate status updates)
# BOSTA_API_KEY=
# COURIER_WEBHOOK_SECRET=         # required Authorization header on /webhook/bosta and /webhook/courier

# ---- Security (recommended on a host)
# TA2KEED_SECRET_KEY=             # encrypts secrets saved by the wizard; default: auto-generated <data>/.master.key
# ADMIN_PASSWORD=                 # dashboard password (or set it in /setup)

# ---- Background jobs: daily summary at notifications.digest_time + review/reorder follow-ups
# SCHEDULER=on
